{
  "name": "mojidara-vivek-cv",
  "version": "1.0.0",
  "private": true,
  "description": "3D portfolio CV website and ATS-friendly PDF résumé for Mojidara Vivek",
  "type": "module",
  "scripts": {
    "build": "esbuild src/scene.js --bundle --format=iife --global-name=CVScene --minify --target=es2020 --legal-comments=eof --outfile=assets/js/scene.bundle.js",
    "serve": "node scripts/serve.mjs",
    "pdf": "node scripts/build-pdf.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "three": "^0.169.0"
  }
}
